## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Ignore build outputs
bin/
obj/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# User created files and folders
/DataBase/
filelist.txt

# Experiment output: runs.csv, its spreadsheet view, the figures and the
# machine-generated environment report. Generated data is never committed —
# it is reproducible from a master seed, and the figures are large.
# methodology.md is written by hand, not generated, so it is kept.
/Results/*
!/Results/methodology.md

# IDE-specific files
.vscode/
.vs/

# Logs
*.log

# Dependency caches
*.cache
*.pdb

# Temporary files
*.tmp
*.ide
